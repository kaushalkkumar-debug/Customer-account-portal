<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>
    <form-beans>
        <form-bean name="loginForm" type="com.example.accounts.struts.LoginForm"/>
    </form-beans>

    <action-mappings>
        <action path="/login"
                type="com.example.accounts.struts.LoginAction"
                name="loginForm"
                scope="request"
                validate="true"
                input="/login.jsp">
            <!-- Forward to the data-loading actions, not straight to the
                 JSPs — dashboard.jsp/admin.jsp need real profile/balance/
                 transaction/account data, not just a static page. -->
            <forward name="customerHome" path="/dashboard.do" redirect="true"/>
            <forward name="adminHome" path="/admin.do" redirect="true"/>
        </action>

        <action path="/dashboard"
                type="com.example.accounts.struts.DashboardAction"
                scope="request">
            <forward name="success" path="/dashboard.jsp"/>
            <forward name="login" path="/login.jsp"/>
        </action>

        <action path="/dashboard/recordTransaction"
                type="com.example.accounts.struts.RecordTransactionAction"
                scope="request">
            <forward name="success" path="/dashboard.do" redirect="true"/>
            <forward name="login" path="/login.jsp"/>
        </action>

        <action path="/dashboard/updateProfile"
                type="com.example.accounts.struts.UpdateProfileAction"
                scope="request">
            <forward name="success" path="/dashboard.do" redirect="true"/>
            <forward name="login" path="/login.jsp"/>
        </action>

        <action path="/admin"
                type="com.example.accounts.struts.AdminAction"
                scope="request">
            <forward name="success" path="/admin.jsp"/>
            <forward name="login" path="/login.jsp"/>
        </action>

        <action path="/admin/toggleActive"
                type="com.example.accounts.struts.ToggleActiveAction"
                scope="request">
            <forward name="success" path="/admin.do" redirect="true"/>
            <forward name="login" path="/login.jsp"/>
        </action>

        <action path="/logout"
                type="com.example.accounts.struts.LogoutAction"
                scope="request">
            <forward name="success" path="/login.jsp"/>
        </action>
    </action-mappings>

    <!-- Required for <html:errors/> on login.jsp to resolve message keys
         like error.login.invalid — without this, ActionServlet never
         plugs in a MessageResources, and any validation/login failure
         throws JspException("Cannot find message resources under key
         org.apache.struts.action.MESSAGE") instead of rendering the
         error page. Found by actually submitting a wrong password
         against the running app, not by the unit tests (which exercise
         the EJB layer directly and never render this JSP). -->
    <message-resources parameter="ApplicationResources"/>
</struts-config>
